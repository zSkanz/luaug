--!strict
--- `GetChildren` and `GetDescendants` from api-design.md §2.2. Both "return
--- fresh arrays" (§3.1), and child order is sibling insertion order (ADR 0026),
--- which is the "child (document) order" the lookup family is defined against.

local testing = require("@luaug/testing")

local describe, it, expect = testing.describe, testing.it, testing.expect
local beforeEach, afterEach = testing.beforeEach, testing.afterEach

local function namedFolder(name: string, parent: Instance?): Folder
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function names(instances: { Instance }): { string }
    local result: { string } = {}
    for _, instance in instances do
        table.insert(result, instance.Name)
    end
    return result
end

describe("Instance children and descendants", function()
    local root: Folder = nil :: any

    beforeEach(function()
        root = Instance.new("Folder")
        root.Name = "ChildrenSpecRoot"
        root.Parent = workspace
    end)

    afterEach(function()
        root:Destroy()
    end)

    describe("GetChildren", function()
        it("returns an empty array for a leaf", function()
            local leaf = namedFolder("Leaf", root)
            expect(leaf:GetChildren()):toEqual({})
            expect(#leaf:GetChildren()):toBe(0)
        end)

        it("returns the direct children in insertion order", function()
            local first = namedFolder("First", root)
            local second = namedFolder("Second", root)
            local third = namedFolder("Third", root)
            expect(root:GetChildren()):toEqual({ first, second, third })
        end)

        it("excludes grandchildren", function()
            local child = namedFolder("Child", root)
            namedFolder("Grandchild", child)
            expect(names(root:GetChildren())):toEqual({ "Child" })
        end)

        it("excludes the instance itself", function()
            local child = namedFolder("Child", root)
            expect(root:GetChildren()).never:toContain(root)
            expect(root:GetChildren()):toContain(child)
        end)

        it("returns a different array on every call", function()
            namedFolder("Child", root)
            local first = root:GetChildren()
            local second = root:GetChildren()
            expect(first).never:toBe(second)
            expect(first):toEqual(second)
        end)

        it("returns an array whose mutation does not reach the tree", function()
            local child = namedFolder("Child", root)
            local snapshot = root:GetChildren()

            table.clear(snapshot)
            table.insert(snapshot, root)

            expect(root:GetChildren()):toEqual({ child })
            expect(child.Parent):toBe(root)
        end)

        it("is not affected by later tree changes", function()
            namedFolder("First", root)
            local snapshot = root:GetChildren()
            namedFolder("Second", root)
            expect(#snapshot):toBe(1)
            expect(#root:GetChildren()):toBe(2)
        end)

        it("drops a detached child immediately", function()
            local first = namedFolder("First", root)
            local second = namedFolder("Second", root)
            first.Parent = nil
            expect(root:GetChildren()):toEqual({ second })
        end)

        it("places a re-parented child last", function()
            local first = namedFolder("First", root)
            local second = namedFolder("Second", root)
            local third = namedFolder("Third", root)
            first.Parent = nil
            first.Parent = root
            expect(root:GetChildren()):toEqual({ second, third, first })
        end)

        it("keeps its order when a child is renamed", function()
            local first = namedFolder("First", root)
            local second = namedFolder("Second", root)
            first.Name = "Zulu"
            expect(root:GetChildren()):toEqual({ first, second })
        end)

        it("keeps duplicate-named siblings as separate entries", function()
            local first = namedFolder("Tree", root)
            local second = namedFolder("Tree", root)
            expect(root:GetChildren()):toEqual({ first, second })
        end)
    end)

    describe("GetDescendants", function()
        it("returns an empty array for a leaf", function()
            local leaf = namedFolder("Leaf", root)
            expect(leaf:GetDescendants()):toEqual({})
        end)

        it("returns every descendant", function()
            local branch = namedFolder("Branch", root)
            local leaf = namedFolder("Leaf", branch)
            local other = namedFolder("Other", root)

            local descendants = root:GetDescendants()

            expect(#descendants):toBe(3)
            expect(descendants):toContain(branch)
            expect(descendants):toContain(leaf)
            expect(descendants):toContain(other)
        end)

        it("excludes the instance itself", function()
            namedFolder("Child", root)
            expect(root:GetDescendants()).never:toContain(root)
        end)

        it("returns descendants in depth-first document order", function()
            -- Each child is followed by its own subtree before the next sibling:
            -- the same document order `FindFirstChild` is defined against.
            local a = namedFolder("A", root)
            local a1 = namedFolder("A1", a)
            local a2 = namedFolder("A2", a)
            local a2x = namedFolder("A2X", a2)
            local b = namedFolder("B", root)
            local b1 = namedFolder("B1", b)

            expect(root:GetDescendants()):toEqual({ a, a1, a2, a2x, b, b1 })
        end)

        it("returns a different array on every call", function()
            namedFolder("Child", root)
            local first = root:GetDescendants()
            local second = root:GetDescendants()
            expect(first).never:toBe(second)
            expect(first):toEqual(second)
        end)

        it("returns an array whose mutation does not reach the tree", function()
            local child = namedFolder("Child", root)
            local snapshot = root:GetDescendants()

            table.clear(snapshot)

            expect(root:GetDescendants()):toEqual({ child })
            expect(child.Parent):toBe(root)
        end)

        it("loses a detached subtree entirely", function()
            local branch = namedFolder("Branch", root)
            namedFolder("Leaf", branch)
            local other = namedFolder("Other", root)

            branch.Parent = nil

            expect(root:GetDescendants()):toEqual({ other })
        end)

        it("gains a whole subtree when one is moved in", function()
            local branch = namedFolder("Branch", nil)
            local leaf = namedFolder("Leaf", branch)

            branch.Parent = root

            expect(root:GetDescendants()):toEqual({ branch, leaf })
        end)
    end)
end)
