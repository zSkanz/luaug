--!strict
--- Conformance: TagService (docs/api-design.md 2.1, 3.1, 8).
---
--- TagService is the query and observation half of tagging: `GetTagged` reads
--- the current set, and the added/removed signals are ordinary deferred
--- signals, so each of them is checked both for not having run yet and for
--- having run after a resumption point. The obby template builds checkpoints
--- on `GetInstanceAddedSignal`, which makes "fires once for a repeated
--- AddTag" a real contract rather than a nicety.

local testing = require("@luaug/testing")

local describe, it, expect = testing.describe, testing.it, testing.expect
local beforeEach, afterEach = testing.beforeEach, testing.afterEach

--- Tag names unique to this file, so a tag another spec leaves behind for a
--- drain cannot make a GetAllTags case pass or fail by accident.
local ALPHA = "ConformanceTagServiceAlpha"
local BETA = "ConformanceTagServiceBeta"
local UNUSED = "ConformanceTagServiceUnused"

local function countOf(list: { any }, value: any): number
    local total = 0
    for _, entry in list do
        if entry == value then
            total += 1
        end
    end
    return total
end

describe("TagService", function()
    local tagService: TagService
    local scratch: Folder
    local subject: Folder
    local connections: { Connection }

    beforeEach(function()
        tagService = game:GetService("TagService")

        scratch = Instance.new("Folder")
        scratch.Name = "ConformanceTagService"
        scratch.Parent = workspace

        subject = Instance.new("Folder")
        subject.Name = "Subject"
        subject.Parent = scratch

        connections = {}
    end)

    afterEach(function()
        for _, connection in connections do
            connection:Disconnect()
        end
        subject:RemoveTag(ALPHA)
        subject:RemoveTag(BETA)
        scratch:Destroy()
    end)

    local function keep(connection: Connection): Connection
        table.insert(connections, connection)
        return connection
    end

    describe("acquisition", function()
        it("is a singleton child of game", function()
            expect(game:GetService("TagService")).toBe(tagService)
            expect(tagService.Parent).toBe(game)
            expect(tagService.ClassName).toBe("TagService")
        end)
    end)

    describe("GetTagged", function()
        it("returns an empty array for a tag nothing carries", function()
            expect(#tagService:GetTagged(UNUSED)).toBe(0)
        end)

        it("returns the instance that carries the tag", function()
            subject:AddTag(ALPHA)
            expect(tagService:GetTagged(ALPHA)).toContain(subject)
        end)

        it("reflects AddTag without waiting for a resumption point", function()
            subject:AddTag(ALPHA)
            expect(#tagService:GetTagged(ALPHA)).toBe(1)
        end)

        it("drops the instance after RemoveTag", function()
            subject:AddTag(ALPHA)
            subject:RemoveTag(ALPHA)
            expect(#tagService:GetTagged(ALPHA)).toBe(0)
        end)

        it("returns every instance carrying the tag", function()
            local second = Instance.new("Folder")
            second.Parent = scratch
            local third = Instance.new("Folder")
            third.Parent = scratch

            subject:AddTag(ALPHA)
            second:AddTag(ALPHA)
            third:AddTag(ALPHA)

            local tagged = tagService:GetTagged(ALPHA)
            expect(#tagged).toBe(3)
            expect(tagged).toContain(subject)
            expect(tagged).toContain(second)
            expect(tagged).toContain(third)
        end)

        it("lists an instance once however many times the tag was added", function()
            subject:AddTag(ALPHA)
            subject:AddTag(ALPHA)
            expect(countOf(tagService:GetTagged(ALPHA), subject)).toBe(1)
        end)

        it("includes an instance whose Parent is nil", function()
            local orphan = Instance.new("Folder")
            orphan:AddTag(BETA)
            expect(tagService:GetTagged(BETA)).toContain(orphan)
            orphan:RemoveTag(BETA)
            orphan:Destroy()
        end)

        it("returns a fresh array on every call", function()
            subject:AddTag(ALPHA)

            local first = tagService:GetTagged(ALPHA)
            table.clear(first)

            expect(#tagService:GetTagged(ALPHA)).toBe(1)
        end)

        it("keeps two tags apart", function()
            subject:AddTag(ALPHA)
            expect(#tagService:GetTagged(BETA)).toBe(0)
        end)
    end)

    describe("GetAllTags", function()
        it("lists a tag once it is in use", function()
            subject:AddTag(ALPHA)
            expect(tagService:GetAllTags()).toContain(ALPHA)
        end)

        it("does not list a tag nothing carries", function()
            expect(tagService:GetAllTags()).never:toContain(UNUSED)
        end)

        it("lists a tag once however many instances carry it", function()
            local second = Instance.new("Folder")
            second.Parent = scratch

            subject:AddTag(ALPHA)
            second:AddTag(ALPHA)

            expect(countOf(tagService:GetAllTags(), ALPHA)).toBe(1)
        end)

        it("drops a tag once the last instance stops carrying it", function()
            subject:AddTag(ALPHA)
            subject:RemoveTag(ALPHA)
            expect(tagService:GetAllTags()).never:toContain(ALPHA)
        end)

        it("returns strings", function()
            subject:AddTag(ALPHA)
            for _, tag in tagService:GetAllTags() do
                expect(tag).toBeA("string")
            end
        end)
    end)

    describe("GetInstanceAddedSignal", function()
        it("does not run the handler before the next resumption point", function()
            local runs = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:AddTag(ALPHA)
            expect(runs).toBe(0)
        end)

        it("passes the tagged instance at the next resumption point", function()
            local seen: { Instance } = {}
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function(instance)
                table.insert(seen, instance)
            end))

            subject:AddTag(ALPHA)
            task.wait()
            expect(seen).toContain(subject)
            expect(#seen).toBe(1)
        end)

        it("fires once for a repeated AddTag", function()
            local runs = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:AddTag(ALPHA)
            subject:AddTag(ALPHA)
            subject:AddTag(ALPHA)
            task.wait()
            expect(runs).toBe(1)
        end)

        it("fires again after the tag is removed and added back", function()
            local runs = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:AddTag(ALPHA)
            task.wait()
            subject:RemoveTag(ALPHA)
            task.wait()
            subject:AddTag(ALPHA)
            task.wait()
            expect(runs).toBe(2)
        end)

        it("does not fire for a different tag", function()
            local runs = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:AddTag(BETA)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("fires for every instance that takes the tag", function()
            local second = Instance.new("Folder")
            second.Parent = scratch

            local seen: { Instance } = {}
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function(instance)
                table.insert(seen, instance)
            end))

            subject:AddTag(ALPHA)
            second:AddTag(ALPHA)
            task.wait()
            expect(#seen).toBe(2)
            expect(seen).toContain(subject)
            expect(seen).toContain(second)
        end)

        -- 3.1: a connection made after the fire does not run for it.
        it("does not deliver a tag added before the connection was made", function()
            subject:AddTag(ALPHA)

            local runs = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            task.wait()
            expect(runs).toBe(0)
        end)

        it("stops delivering after Disconnect", function()
            local runs = 0
            local connection = keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            connection:Disconnect()
            subject:AddTag(ALPHA)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("delivers to every connection made through separate calls", function()
            local first = 0
            local second = 0
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                first += 1
            end))
            keep(tagService:GetInstanceAddedSignal(ALPHA):Connect(function()
                second += 1
            end))

            subject:AddTag(ALPHA)
            task.wait()
            expect(first).toBe(1)
            expect(second).toBe(1)
        end)
    end)

    describe("GetInstanceRemovedSignal", function()
        it("does not run the handler before the next resumption point", function()
            subject:AddTag(ALPHA)
            task.wait()

            local runs = 0
            keep(tagService:GetInstanceRemovedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:RemoveTag(ALPHA)
            expect(runs).toBe(0)
        end)

        it("passes the untagged instance at the next resumption point", function()
            subject:AddTag(ALPHA)
            task.wait()

            local seen: { Instance } = {}
            keep(tagService:GetInstanceRemovedSignal(ALPHA):Connect(function(instance)
                table.insert(seen, instance)
            end))

            subject:RemoveTag(ALPHA)
            task.wait()
            expect(seen).toContain(subject)
            expect(#seen).toBe(1)
        end)

        it("does not fire when the instance never carried the tag", function()
            local runs = 0
            keep(tagService:GetInstanceRemovedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:RemoveTag(ALPHA)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("does not fire for a different tag", function()
            subject:AddTag(ALPHA)
            subject:AddTag(BETA)
            task.wait()

            local runs = 0
            keep(tagService:GetInstanceRemovedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:RemoveTag(BETA)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("does not fire when the tag is added", function()
            local runs = 0
            keep(tagService:GetInstanceRemovedSignal(ALPHA):Connect(function()
                runs += 1
            end))

            subject:AddTag(ALPHA)
            task.wait()
            expect(runs).toBe(0)
        end)
    end)
end)
