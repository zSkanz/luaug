--!strict
--- Conformance: removed globals (docs/api-design.md 1.1, 2.5 divergences 2
--- and 21; ADR 0015).
---
--- 1.1 lists the globals LuauG deliberately does not have, "no aliases", and
--- divergence 2 says the footguns are killed at birth. A rename list is only
--- frozen if the old names are actually gone, so this file asserts the
--- absence of each one.
---
--- It is a separate file for one reason: naming a global that does not exist
--- is itself a strict-mode type error, so these cases only analyze if the
--- generated `engine.d.luau` declares each removed name as `nil` -- a
--- declaration whose whole purpose is to let this suite exist. If that
--- declaration is not made, this file cannot ship and the rule loses its
--- only runtime check.

local testing = require("@luaug/testing")

local describe, it, expect = testing.describe, testing.it, testing.expect

describe("removed scheduling globals", function()
    it("has no wait", function()
        expect(wait).toBeNil()
    end)

    it("has no spawn", function()
        expect(spawn).toBeNil()
    end)

    it("has no delay", function()
        expect(delay).toBeNil()
    end)

    it("has no tick", function()
        expect(tick).toBeNil()
    end)

    it("has no elapsedTime", function()
        expect(elapsedTime).toBeNil()
    end)

    it("provides the whole scheduling surface on task instead", function()
        expect(task.spawn).toBeA("function")
        expect(task.defer).toBeA("function")
        expect(task.delay).toBeA("function")
        expect(task.wait).toBeA("function")
        expect(task.cancel).toBeA("function")
    end)
end)

describe("removed environment globals", function()
    it("has no loadstring", function()
        expect(loadstring).toBeNil()
    end)

    it("has no getfenv", function()
        expect(getfenv).toBeNil()
    end)

    it("has no setfenv", function()
        expect(setfenv).toBeNil()
    end)

    it("has no newproxy", function()
        expect(newproxy).toBeNil()
    end)

    -- `shared` was the cross-script table; its absence is half of what makes
    -- the per-script sandbox mean anything.
    it("has no shared", function()
        expect(shared).toBeNil()
    end)

    it("has no io in the game VM", function()
        expect(io).toBeNil()
    end)
end)

describe("globals that remain", function()
    it("keeps the world globals 1.1 lists", function()
        expect(game).never:toBeNil()
        expect(workspace).never:toBeNil()
        expect(script).never:toBeNil()
        expect(Instance).never:toBeNil()
        expect(Enum).never:toBeNil()
    end)

    it("keeps the Luau builtins 1.1 lists", function()
        expect(task).never:toBeNil()
        expect(vector).never:toBeNil()
        expect(buffer).never:toBeNil()
        expect(utf8).never:toBeNil()
        expect(print).toBeA("function")
        expect(warn).toBeA("function")
        expect(error).toBeA("function")
        expect(assert).toBeA("function")
        expect(pcall).toBeA("function")
        expect(xpcall).toBeA("function")
        expect(require).toBeA("function")
        expect(typeof).toBeA("function")
        expect(tostring).toBeA("function")
    end)
end)
