--!strict
--- Conformance: attribute change signals (docs/api-design.md 2.2, 2.5, 3.1).
---
--- Divergence 8 removes the `.Changed` catch-all, which makes
--- `GetAttributeChangedSignal` and `AttributeChanged` the only way to observe
--- an attribute write. They are ordinary deferred signals, so every case here
--- also pins 3.1: nothing runs before the next resumption point, and a spec
--- that never waits is asserting nothing.

local testing = require("@luaug/testing")

local describe, it, expect = testing.describe, testing.it, testing.expect
local beforeEach, afterEach = testing.beforeEach, testing.afterEach

describe("attribute change signals", function()
    local scratch: Folder
    local subject: Folder
    local connections: { Connection }

    beforeEach(function()
        scratch = Instance.new("Folder")
        scratch.Name = "ConformanceAttributeSignals"
        scratch.Parent = workspace

        subject = Instance.new("Folder")
        subject.Name = "Subject"
        subject.Parent = scratch

        connections = {}
    end)

    afterEach(function()
        for _, connection in connections do
            connection:Disconnect()
        end
        scratch:Destroy()
    end)

    local function keep(connection: Connection): Connection
        table.insert(connections, connection)
        return connection
    end

    describe("GetAttributeChangedSignal", function()
        it("does not run the handler before the next resumption point", function()
            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Health", 1)
            expect(runs).toBe(0)
        end)

        it("runs the handler at the next resumption point", function()
            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Health", 1)
            task.wait()
            expect(runs).toBe(1)
        end)

        it("shows the handler the value that was written", function()
            local seen: any = nil
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                seen = subject:GetAttribute("Health")
            end))

            subject:SetAttribute("Health", 7)
            task.wait()
            expect(seen).toBe(7)
        end)

        it("fires once per write when several writes precede one drain", function()
            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Health", 1)
            subject:SetAttribute("Health", 2)
            subject:SetAttribute("Health", 3)
            task.wait()
            expect(runs).toBe(3)
        end)

        it("does not fire when the attribute is written the value it already holds", function()
            subject:SetAttribute("Health", 1)
            task.wait()

            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Health", 1)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("fires when the attribute is removed", function()
            subject:SetAttribute("Health", 1)
            task.wait()

            local runs = 0
            local seen: any = "unset"
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
                seen = subject:GetAttribute("Health")
            end))

            subject:SetAttribute("Health", nil)
            task.wait()
            expect(runs).toBe(1)
            expect(seen).toBeNil()
        end)

        it("fires only for the attribute it was asked for", function()
            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Faction", "blue")
            task.wait()
            expect(runs).toBe(0)
        end)

        it("fires only for the instance it was asked for", function()
            local other = Instance.new("Folder")
            other.Parent = scratch

            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            other:SetAttribute("Health", 1)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("delivers to every connection made through separate calls", function()
            local first = 0
            local second = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                first += 1
            end))
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                second += 1
            end))

            subject:SetAttribute("Health", 1)
            task.wait()
            expect(first).toBe(1)
            expect(second).toBe(1)
        end)

        it("runs handlers of one fire in the order they were connected", function()
            local order: { string } = {}
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                table.insert(order, "first")
            end))
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                table.insert(order, "second")
            end))

            subject:SetAttribute("Health", 1)
            task.wait()
            expect(order[1]).toBe("first")
            expect(order[2]).toBe("second")
        end)

        it("stops delivering after Disconnect", function()
            local runs = 0
            local connection = keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            connection:Disconnect()
            subject:SetAttribute("Health", 1)
            task.wait()
            expect(runs).toBe(0)
        end)

        -- 3.1: a connection made after the fire was enqueued was not listening
        -- when the thing happened.
        it("does not deliver a write that happened before the connection was made", function()
            subject:SetAttribute("Health", 1)

            local runs = 0
            keep(subject:GetAttributeChangedSignal("Health"):Connect(function()
                runs += 1
            end))

            task.wait()
            expect(runs).toBe(0)
        end)

        it("runs a Once handler exactly once across repeated writes", function()
            local runs = 0
            subject:GetAttributeChangedSignal("Health"):Once(function()
                runs += 1
            end)

            subject:SetAttribute("Health", 1)
            subject:SetAttribute("Health", 2)
            task.wait()
            subject:SetAttribute("Health", 3)
            task.wait()
            expect(runs).toBe(1)
        end)
    end)

    describe("AttributeChanged", function()
        it("passes the name of the attribute that changed", function()
            local names: { string } = {}
            keep(subject.AttributeChanged:Connect(function(name)
                table.insert(names, name)
            end))

            subject:SetAttribute("Health", 1)
            task.wait()
            expect(names).toContain("Health")
            expect(#names).toBe(1)
        end)

        it("fires for any attribute, not one named in advance", function()
            local names: { string } = {}
            keep(subject.AttributeChanged:Connect(function(name)
                table.insert(names, name)
            end))

            subject:SetAttribute("Health", 1)
            subject:SetAttribute("Faction", "blue")
            task.wait()
            expect(names).toContain("Health")
            expect(names).toContain("Faction")
            expect(#names).toBe(2)
        end)

        it("fires when an attribute is removed", function()
            subject:SetAttribute("Health", 1)
            task.wait()

            local names: { string } = {}
            keep(subject.AttributeChanged:Connect(function(name)
                table.insert(names, name)
            end))

            subject:SetAttribute("Health", nil)
            task.wait()
            expect(names).toContain("Health")
        end)

        it("does not run before the next resumption point", function()
            local runs = 0
            keep(subject.AttributeChanged:Connect(function()
                runs += 1
            end))

            subject:SetAttribute("Health", 1)
            expect(runs).toBe(0)
            task.wait()
            expect(runs).toBe(1)
        end)

        it("does not fire for an attribute written on another instance", function()
            local other = Instance.new("Folder")
            other.Parent = scratch

            local runs = 0
            keep(subject.AttributeChanged:Connect(function()
                runs += 1
            end))

            other:SetAttribute("Health", 1)
            task.wait()
            expect(runs).toBe(0)
        end)

        it("resumes a coroutine parked in Wait with the attribute name", function()
            task.defer(function()
                subject:SetAttribute("Health", 1)
            end)

            local name = subject.AttributeChanged:Wait()
            expect(name).toBe("Health")
        end)
    end)
end)
