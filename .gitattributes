# Normalize line endings: LF in the repository, LF on checkout by default.
* text=auto eol=lf

# Windows-native script formats keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binary content — never diff, never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.ktx2 binary
*.basis binary
*.glb binary
*.bin binary
*.pak binary
*.lpack binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.ico binary

# Golden images: binary and excluded from textual diffs.
tests/**/golden/** binary -diff

# Vendored third-party source: mark as vendored for tooling/linguist.
# `-text` disables the `text=auto eol=lf` normalization above: a vendored tree
# must be byte-identical to the upstream commit the manifest pins (R13), and
# rewriting line endings would silently edit it in place.
#
# `!eol` is the other half, and it is not decoration. Git documents `eol` as
# implying `text`, so the `*.bat text eol=crlf` rule above kept applying to
# vendored `.bat` files even with `text` unset here -- Jolt ships twenty-three
# of them and checking them out rewrote every one. `!eol` makes the attribute
# unspecified rather than set, which is the only spelling that means "leave
# this tree completely alone".
third_party/** linguist-vendored -text !eol

# Note: adoption of git-LFS for large assets is decided via ADR at milestone M4
# (when real art assets first land). Until then keep binary assets tiny.
