--!strict
--[[
	The wire schema's C++ (ADR 0069).

	**One table, generated, so that the schema and the code that reads it cannot
	disagree.** A hand-written encoder drifts from the state it encodes in the
	direction that matters: a field added to the world and forgotten on the wire
	is a replica confidently wrong about what decides the next tick, and nothing
	fails while it is wrong.

	What this emits is a *description* -- names, ids, encodings, and which pool a
	value is read from. It emits no reader and no writer: those are hand-written
	in `engine/replication/src/`, against this table, exactly as
	`native_accessors.cpp` is hand-written against `gen_cpp`'s descriptors. The
	generator never learns what a component is, which is the same rule
	`architecture.md` §4 states about the API generator and is what keeps moving
	a field's storage a change in one C++ file.

	The output is CHECKED IN and diff-checked by `scripts/gates/luau-check.sh`,
	the same arrangement every other generated artifact has: Lute stays off the
	critical path of a C++ build, and drift is a build failure rather than a
	discovery.

	**And the published protocol** (ADR 0100): `docs/protocol/wire.md` is written
	from the same schema -- the encodings, the channels, every message's layout,
	every replicated class's fields -- so the specification a third party builds a
	peer from is the one the engine was compiled against.

	    lute api/generator/gen_wire.luau
]]

local fs = require("@std/fs")
local process = require("@std/process")

local Schema = require("../wire/schema")
local Wire = require("../wire")

local OutputPath = "engine/replication/generated/wire_schema.gen.h"
local SpecificationPath = "docs/protocol/wire.md"

local Common: { Schema.Field } = Wire.Definition.Common or {}
local Classes: { Schema.Class } = Wire.Definition.Classes or {}
local Channels: { Schema.Channel } = Wire.Definition.Channels or {}
local Messages: { Schema.Message } = Wire.Definition.Messages or {}

local function fail(message: string): never
    print(`gen_wire: ERROR: {message}`)
    return process.exit(1)
end

local problems = Wire.validate(Wire.Definition)
if #problems > 0 then
    for _, problem in problems do
        print(`gen_wire: {problem}`)
    end
    fail(`{#problems} problem(s) in the wire schema; nothing was written`)
end

local lines: { string } = {}

local function emit(line: string)
    table.insert(lines, line)
end

emit("// GENERATED by api/generator/gen_wire.luau from api/wire/. Do not edit.")
emit("//")
emit("// The wire schema as C++: what a replica is told, and under which permanent")
emit("// field id. `api/wire/state.wire.luau` is where the decisions live and where")
emit("// each one is argued; this file is the same facts in a form a decoder can")
emit("// index. See ADR 0069.")
emit("#pragma once")
emit("")
emit('#include "luaug/core/types.h"')
emit("")
emit("#include <span>")
emit("#include <string_view>")
emit("")
emit("namespace luaug::replication::generated {")
emit("")
emit("using core::u16;")
emit("using core::u32;")
emit("using core::u8;")
emit("")
emit("// Bumped by hand in the commit that changes the wire, and never derived from")
emit("// the engine version: a release that changes nothing about the protocol must")
emit("// not refuse a peer, and a wire change inside one release must.")
emit(`inline constexpr u32 ProtocolVersion = {Wire.ProtocolVersion};`)
emit("")

-- The encodings, as an enum a decoder switches on.
emit("// How a field's bytes are laid down. Every one is fixed-width and")
emit("// little-endian, with no variable-length forms and no nesting -- a wire format")
emit("// whose parser can recurse has a stack-depth question in it, and that question")
emit("// is always answered by somebody hostile rather than by a test.")
emit("enum class Encoding : u8")
emit("{")

for index, encoding in Schema.Encodings do
    emit(`    {encoding.Name} = {index - 1},`)
end
emit("};")
emit("")
emit("// Each encoding's size on the wire, as the published protocol states it (ADR")
emit("// 0100). A test holds `wireBytes` to it, so the two cannot disagree.")
emit("inline constexpr u8 EncodingBytes[] = {")
for _, encoding in Schema.Encodings do
    emit(`    {encoding.Bytes}, // {encoding.Name}`)
end
emit("};")
emit("")

-- Where a field is read from.
emit("// **`Component` is the case that matters.** The most-replicated fact in any")
emit("// game -- where things are -- is written into the component directly by")
emit("// `PhysicsSync` and never reaches `setProperty` at all, so a schema that could")
emit("// only name properties could not replicate motion (ADR 0069).")
emit("enum class Source : u8")
emit("{")
emit("    Property = 0,")
emit("    Component = 1,")
emit("};")
emit("")

emit("struct FieldDesc")
emit("{")
emit("    std::string_view name;")
emit("    // **Permanent.** Unique within its class, never reused, claimed for ever")
emit("    // once retired.")
emit("    u16 id = 0;")
emit("    Encoding encoding = Encoding::Bool;")
emit("    Source source = Source::Property;")
emit("    // The component pool, as `LUAUG_SCENE_POOL_LIST` names it. Empty for a")
emit("    // property.")
emit("    std::string_view pool;")
emit("};")
emit("")
emit("struct ClassDesc")
emit("{")
emit("    std::string_view name;")
emit("    std::span<const FieldDesc> fields;")
emit("    // The index in `Classes` of the class whose fields this one also carries,")
emit("    // or -1. One level: a `CharacterBody` is a `BasePart`.")
emit("    int base = -1;")
emit("    // A service: one per world, on both ends from boot, so it is never")
emit("    // spawned, never leaves interest, and travels under a fixed id.")
emit("    bool service = false;")
emit("    // A service whose children replicate to every replica, whatever their")
emit("    // position (ADR 0080).")
emit("    bool contents = false;")
emit("};")
emit("")

local function encodingOf(field: Schema.Field): string
    return `Encoding::{field.Encoding}`
end

local function sourceOf(field: Schema.Field): string
    return `Source::{field.Source}`
end

local function quote(text: string): string
    return `"{text}"`
end

--- Whether a class got an array of its own. A class with no fields does not:
--- a zero-length array is illegal in C++ and MSVC says so, so its `ClassDesc`
--- carries a default-constructed span instead. `Folder` is the case -- and it is
--- replicated deliberately, with nothing of its own, so a `Parent` reference to
--- one resolves on the replica.
local hasArray: { [string]: boolean } = {}

local function emitFields(name: string, fields: { Schema.Field })
    if #fields == 0 then
        return
    end
    hasArray[name] = true
    emit(`inline constexpr FieldDesc {name}[] = ` .. "{")
    for _, field in fields do
        local pool = if field.Component ~= nil then quote(field.Component) else '""'
        emit("    {" .. `{quote(field.Name)}, {field.Id}, {encodingOf(field)}, {sourceOf(field)}, {pool}` .. "},")
    end
    emit("};")
    emit("")
end

emit("// The fields every replicated instance carries whatever its class.")
emit("//")
emit("// **Not a class entry for `Instance`**: every class extends it, so treating it")
emit("// as one would make every class decided by inheritance and the schema's own")
emit("// completeness check would pass on an empty file.")
emitFields("CommonFields", Common)

for _, class in Classes do
    emitFields(`{class.Name}Fields`, class.Fields)
end

emit("// Every replicated class, in schema order.")
emit("inline constexpr ClassDesc Classes[] = {")
local classIndex: { [string]: number } = {}
for index, class in Classes do
    classIndex[class.Name] = index - 1
end
for _, class in Classes do
    local fields = if hasArray[`{class.Name}Fields`] then `{class.Name}Fields` else "{}"
    local base = if class.Extends ~= nil then classIndex[class.Extends] else -1
    local service = if class.Service then "true" else "false"
    local contents = if class.Contents then "true" else "false"
    emit("    {" .. `{quote(class.Name)}, {fields}, {base}, {service}, {contents}` .. "},")
end
emit("};")
emit("")

-- Channels.
emit("// ENet's delivery mode per channel, as `net::Delivery` spells it.")
emit("enum class Delivery : u8")
emit("{")
emit("    Reliable = 0,")
emit("    UnreliableSequenced = 1,")
emit("    Unreliable = 2,")
emit("};")
emit("")
emit("struct ChannelDesc")
emit("{")
emit("    std::string_view name;")
emit("    u8 id = 0;")
emit("    Delivery delivery = Delivery::Reliable;")
emit("};")
emit("")
emit("inline constexpr ChannelDesc Channels[] = {")
for _, channel in Channels do
    emit("    {" .. `{quote(channel.Name)}, {channel.Id}, Delivery::{channel.Delivery}` .. "},")
end
emit("};")
emit("")

-- Messages, as an enum plus a table. The enum is what code switches on.
emit("// The message types. An enum rather than bare numbers, so a switch over them")
emit("// is exhaustive and `-Werror` catches a new one nobody handled.")
emit("enum class MessageType : u8")
emit("{")
for _, message in Messages do
    emit(`    {message.Name} = {message.Id},`)
end
emit("};")
emit("")
emit("// Which direction a message may travel. A server that accepted a")
emit("// `ToReplica` message from a client would be a server accepting whatever a")
emit("// client asserted about the world.")
emit("enum class Direction : u8")
emit("{")
emit("    ToAuthority = 0,")
emit("    ToReplica = 1,")
emit("};")
emit("")
emit("struct MessageDesc")
emit("{")
emit("    std::string_view name;")
emit("    MessageType type = MessageType::Hello;")
emit("    u8 channel = 0;")
emit("    Direction direction = Direction::ToAuthority;")
emit("};")
emit("")

local channelIdOf: { [string]: number } = {}
for _, channel in Channels do
    channelIdOf[channel.Name] = channel.Id
end

emit("inline constexpr MessageDesc Messages[] = {")
for _, message in Messages do
    local channel = channelIdOf[message.Channel]
    if channel == nil then
        fail(`message {message.Name} names channel {message.Channel}, which is not declared`)
    end
    emit(
        "    {"
            .. `{quote(message.Name)}, MessageType::{message.Name}, {channel}, Direction::{message.Direction}`
            .. "},"
    )
end
emit("};")
emit("")
emit("} // namespace luaug::replication::generated")
emit("")

local directory = "engine/replication/generated"
if not fs.exists(directory) then
    fs.createDirectory(directory, { makeParents = true })
end
fs.writeStringToFile(OutputPath, table.concat(lines, "\n"))

local fieldCount = #Common
for _, class in Classes do
    fieldCount += #class.Fields
end

-- --- The published protocol (ADR 0100) ---------------------------------------

local doc: { string } = {}

local function say(line: string)
    table.insert(doc, line)
end

local function cell(text: string?): string
    return (string.gsub(text or "", "|", "\\|"))
end

local Excluded: { Schema.Excluded } = Wire.Definition.Excluded or {}

say("<!-- GENERATED by api/generator/gen_wire.luau from api/wire/. Do not edit. -->")
say("")
say(`# The LuauG wire protocol, version {Wire.ProtocolVersion}`)
say("")
say("What a replica and an authority say to each other, byte for byte. This page is")
say("generated from the schema the engine is compiled against (`api/wire/`), so it")
say("describes exactly the protocol this tree speaks. ADR 0069 designed it, and")
say("[ADR 0100](../decisions/0100-the-wire-protocol-is-published-and-versioned.md) is")
say("the compatibility policy.")
say("")
say("## Compatibility")
say("")
say(`- **One number, and an exact match.** A peer states the version it speaks first`)
say("  in `Hello`; an authority speaking another closes the connection. There is no")
say("  negotiation and no partial compatibility.")
say("- **The number changes whenever the bytes do** -- a field, a message, a layout, an")
say("  encoding. An engine release that leaves the wire alone keeps the number, and")
say("  the CHANGELOG says when a release moves it.")
say("- **Numbers are permanent.** A field id, message id, channel or encoding value is")
say("  never reused for anything else, in any version. A removed field is recorded as")
say("  retired and stays claimed.")
say("- The specification of a released version is this page at that release's tag.")
say("")
say("## Transport")
say("")
say(`ENet, with {#Channels} channels opened on every connection. Each message is one`)
say("packet and begins with a `u8` message type; nothing else frames it.")
say("")
say("| Channel | Name | Delivery | What travels on it |")
say("|---|---|---|---|")
for _, channel in Channels do
    say(`| {channel.Id} | {channel.Name} | {channel.Delivery} | {cell(channel.Doc)} |`)
end
say("")
say("## Primitives")
say("")
say("- Integers are little-endian: `u8`, `u16`, `u32`, `u64`, and `i32` in two's")
say("  complement.")
say("- `f32` and `f64` are IEEE-754, little-endian.")
say("- `text` is a `u16` byte length and then that many bytes of UTF-8, with no")
say("  terminator. A writer truncates at 65535 bytes.")
say("- A reader that runs out of bytes rejects the whole message. Where a section says")
say("  so, trailing bytes reject it too.")
say("")
say("## Encodings")
say("")
say("A field's value is one of these, fixed-width. `Encoding` is the value a schema")
say("gives it.")
say("")
say("| Encoding | Name | Bytes | Layout |")
say("|---|---|---|---|")
for index, encoding in Schema.Encodings do
    say(`| {index - 1} | {encoding.Name} | {encoding.Bytes} | {cell(encoding.Layout)} |`)
end
say("")
say("## Identity")
say("")
say("- **Network ids** are `u32`. 1 is the replicated root, the authority's")
say("  `Workspace`. An instance is numbered from 2 upward as the authority first")
say("  replicates it, and a number is never reused within a session.")
say("- **A service** is never spawned. It travels under `0x7F000000` plus its index")
say("  in the replicated classes below, and each end binds that to its own service of")
say("  the same class. Its `Name` and `Parent` are ignored.")
say("- **User ids** are `u32`: 1 is the player at a solo or hosting machine, and")
say("  replicas are numbered 2 and up in the order they join.")
say("")
say("## Handshake")
say("")
say("1. The replica connects and sends `Hello`.")
say("2. The authority checks the version, makes the player, and answers `Welcome`.")
say("   A refusal is a disconnect.")
say("3. Until `Welcome`, the authority ignores the replica's intents, owned state and")
say("   remote calls.")
say("4. From then on, every tick the authority sends, in this order: `Players` when")
say("   the roster changed, `Despawn`, `Spawn`, `Ownership` when that changed, then")
say("   `Snapshot`. The replica answers each snapshot it applies with `Ack`, and sends")
say("   `Intent` and `OwnedState` every tick.")
say("")
say("## Messages")
say("")
say("| Type | Name | Channel | Direction |")
say("|---|---|---|---|")
for _, message in Messages do
    say(`| {message.Id} | [{message.Name}](#{string.lower(message.Name)}) | {message.Channel} | {message.Direction} |`)
end
say("")

local function layoutRows(parts: { Schema.Part }, depth: number)
    local indent = string.rep("&nbsp;&nbsp;&nbsp;&nbsp;", depth)
    for _, part in parts do
        if part.Type == "repeat" then
            say(`| {indent}` .. `{part.Name} | {part.Count} × | {cell(part.Doc)} |`)
            layoutRows(part.Each or {}, depth + 1)
        else
            say(`| {indent}{part.Name} | {part.Type} | {cell(part.Doc)} |`)
        end
    end
end

for _, message in Messages do
    say(`### {message.Name}`)
    say("")
    say(`Type {message.Id}, on {message.Channel}, {message.Direction}. {message.Doc}`)
    say("")
    say("| Part | Type | |")
    say("|---|---|---|")
    say("| type | u8 | `" .. tostring(message.Id) .. "` |")
    layoutRows(message.Layout, 0)
    say("")
end

say("## Wire ids")
say("")
say("A field in a `Snapshot` record is named by a `u16`:")
say("")
say("- the common fields (below) by their own id;")
say("- a field the class inherits from its base class by its id OR `0x4000`;")
say("- a field of the class's own by its id OR `0x8000`.")
say("")
say("A whole record carries every field in that order -- common, inherited, own --")
say("each once.")
say("")
say("## The checksum")
say("")
say("FNV-1a, 64-bit (offset basis `0xCBF29CE484222325`, prime `0x100000001B3`), over")
say("every instance the replica holds from this authority after applying, in ascending")
say("network id: the id as 4 bytes, the class index as 1 byte, then for every field in")
say("whole-record order its encoded bytes zero-padded to 64. Names are the")
say("authority's numbers. A mismatch means the replica applied something wrongly; it")
say("does not acknowledge that snapshot.")
say("")
say("## Arguments")
say("")
say("A remote call's arguments: a `u8` count, then each value as a `u8` tag and its")
say("payload. 0 nil, 1 false, 2 true (no payload); 3 a number (`f64`); 4 a string")
say("(`u32` length, bytes); 5 a vector (three `f32`); 6 an instance (`u32` index into")
say("the message's refs); 7 a table (`u32` pair count, then key and value for each).")
say("At most 64 KiB and eight tables deep. A key is never a vector, an instance or a")
say("table, and a failed answer is exactly one string.")
say("")
say("## Replicated classes")
say("")
say("The class index is a record's `schema` byte.")
say("")

local function fieldRows(fields: { Schema.Field })
    say("| Id | Field | Encoding | Why it travels |")
    say("|---|---|---|---|")
    for _, field in fields do
        say(`| {field.Id} | {field.Name} | {field.Encoding} | {cell(field.Doc)} |`)
    end
    say("")
end

say("### Common to every class")
say("")
fieldRows(Common)
for index, class in Classes do
    say(`### {index - 1} — {class.Name}`)
    say("")
    local notes: { string } = {}
    if class.Extends ~= nil then
        table.insert(notes, `Carries \`{class.Extends}\`'s fields too.`)
    end
    if class.Service then
        table.insert(notes, `A service, under network id \`0x{string.format("%08X", 0x7F000000 + index - 1)}\`.`)
    end
    if class.Contents then
        table.insert(notes, "Everything under it reaches every replica, whatever the distance.")
    end
    if class.Doc ~= nil then
        table.insert(notes, class.Doc)
    end
    say(table.concat(notes, " "))
    say("")
    if #class.Fields > 0 then
        fieldRows(class.Fields)
    end
    if class.Retired ~= nil and #class.Retired > 0 then
        say("Retired, and claimed for ever:")
        say("")
        for _, retired in class.Retired do
            say(`- {retired.Id} \`{retired.Name}\`, since {retired.Since}: {retired.Reason}`)
        end
        say("")
    end
end

say("## Not replicated")
say("")
say("Every other concrete class is deliberately off the wire, and this is why.")
say("")
say("| Class | Reason |")
say("|---|---|")
for _, excluded in Excluded do
    say(`| {excluded.Name} | {cell(excluded.Reason)} |`)
end
say("")

if not fs.exists("docs/protocol") then
    fs.createDirectory("docs/protocol", { makeParents = true })
end
fs.writeStringToFile(SpecificationPath, table.concat(doc, "\n"))

print(
    `gen_wire: wrote {OutputPath} and {SpecificationPath} -- protocol v{Wire.ProtocolVersion}, `
        .. `{#Classes} class(es), {fieldCount} field(s), {#Channels} channel(s), {#Messages} message(s)`
)
