--!strict
--[[
	The wire schema's C++ (ADR 0069).

	**One table, generated, so that the schema and the code that reads it cannot
	disagree.** A hand-written encoder drifts from the state it encodes in the
	direction that matters: a field added to the world and forgotten on the wire
	is a replica confidently wrong about what decides the next tick, and nothing
	fails while it is wrong.

	What this emits is a *description* -- names, ids, encodings, and which pool a
	value is read from. It emits no reader and no writer: those are hand-written
	in `engine/replication/src/`, against this table, exactly as
	`native_accessors.cpp` is hand-written against `gen_cpp`'s descriptors. The
	generator never learns what a component is, which is the same rule
	`architecture.md` §4 states about the API generator and is what keeps moving
	a field's storage a change in one C++ file.

	The output is CHECKED IN and diff-checked by `scripts/gates/luau-check.sh`,
	the same arrangement every other generated artifact has: Lute stays off the
	critical path of a C++ build, and drift is a build failure rather than a
	discovery.

	    lute api/generator/gen_wire.luau
]]

local fs = require("@std/fs")
local process = require("@std/process")

local Schema = require("../wire/schema")
local Wire = require("../wire")

local OutputPath = "engine/replication/generated/wire_schema.gen.h"

local Common: { Schema.Field } = Wire.Definition.Common or {}
local Classes: { Schema.Class } = Wire.Definition.Classes or {}
local Channels: { Schema.Channel } = Wire.Definition.Channels or {}
local Messages: { Schema.Message } = Wire.Definition.Messages or {}

local function fail(message: string): never
    print(`gen_wire: ERROR: {message}`)
    return process.exit(1)
end

local problems = Wire.validate(Wire.Definition)
if #problems > 0 then
    for _, problem in problems do
        print(`gen_wire: {problem}`)
    end
    fail(`{#problems} problem(s) in the wire schema; nothing was written`)
end

local lines: { string } = {}

local function emit(line: string)
    table.insert(lines, line)
end

emit("// GENERATED by api/generator/gen_wire.luau from api/wire/. Do not edit.")
emit("//")
emit("// The wire schema as C++: what a replica is told, and under which permanent")
emit("// field id. `api/wire/state.wire.luau` is where the decisions live and where")
emit("// each one is argued; this file is the same facts in a form a decoder can")
emit("// index. See ADR 0069.")
emit("#pragma once")
emit("")
emit('#include "luaug/core/types.h"')
emit("")
emit("#include <span>")
emit("#include <string_view>")
emit("")
emit("namespace luaug::replication::generated {")
emit("")
emit("using core::u16;")
emit("using core::u32;")
emit("using core::u8;")
emit("")
emit("// Bumped by hand in the commit that changes the wire, and never derived from")
emit("// the engine version: a release that changes nothing about the protocol must")
emit("// not refuse a peer, and a wire change inside one release must.")
emit(`inline constexpr u32 ProtocolVersion = {Wire.ProtocolVersion};`)
emit("")

-- The encodings, as an enum a decoder switches on.
emit("// How a field's bytes are laid down. Every one is fixed-width and")
emit("// little-endian, with no variable-length forms and no nesting -- a wire format")
emit("// whose parser can recurse has a stack-depth question in it, and that question")
emit("// is always answered by somebody hostile rather than by a test.")
emit("enum class Encoding : u8")
emit("{")

local EncodingOrder: { string } = {
    "Bool",
    "U8",
    "U16",
    "U32",
    "I32",
    "F32",
    "F64",
    "Vector3",
    "Position",
    "CFrameD",
    "Color3",
    "NameAtom",
    "InstanceRef",
}
for index, name in EncodingOrder do
    emit(`    {name} = {index - 1},`)
end
emit("};")
emit("")

-- Where a field is read from.
emit("// **`Component` is the case that matters.** The most-replicated fact in any")
emit("// game -- where things are -- is written into the component directly by")
emit("// `PhysicsSync` and never reaches `setProperty` at all, so a schema that could")
emit("// only name properties could not replicate motion (ADR 0069).")
emit("enum class Source : u8")
emit("{")
emit("    Property = 0,")
emit("    Component = 1,")
emit("};")
emit("")

emit("struct FieldDesc")
emit("{")
emit("    std::string_view name;")
emit("    // **Permanent.** Unique within its class, never reused, claimed for ever")
emit("    // once retired.")
emit("    u16 id = 0;")
emit("    Encoding encoding = Encoding::Bool;")
emit("    Source source = Source::Property;")
emit("    // The component pool, as `LUAUG_SCENE_POOL_LIST` names it. Empty for a")
emit("    // property.")
emit("    std::string_view pool;")
emit("};")
emit("")
emit("struct ClassDesc")
emit("{")
emit("    std::string_view name;")
emit("    std::span<const FieldDesc> fields;")
emit("};")
emit("")

local function encodingOf(field: Schema.Field): string
    return `Encoding::{field.Encoding}`
end

local function sourceOf(field: Schema.Field): string
    return `Source::{field.Source}`
end

local function quote(text: string): string
    return `"{text}"`
end

--- Whether a class got an array of its own. A class with no fields does not:
--- a zero-length array is illegal in C++ and MSVC says so, so its `ClassDesc`
--- carries a default-constructed span instead. `Folder` is the case -- and it is
--- replicated deliberately, with nothing of its own, so a `Parent` reference to
--- one resolves on the replica.
local hasArray: { [string]: boolean } = {}

local function emitFields(name: string, fields: { Schema.Field })
    if #fields == 0 then
        return
    end
    hasArray[name] = true
    emit(`inline constexpr FieldDesc {name}[] = ` .. "{")
    for _, field in fields do
        local pool = if field.Component ~= nil then quote(field.Component) else '""'
        emit("    {" .. `{quote(field.Name)}, {field.Id}, {encodingOf(field)}, {sourceOf(field)}, {pool}` .. "},")
    end
    emit("};")
    emit("")
end

emit("// The fields every replicated instance carries whatever its class.")
emit("//")
emit("// **Not a class entry for `Instance`**: every class extends it, so treating it")
emit("// as one would make every class decided by inheritance and the schema's own")
emit("// completeness check would pass on an empty file.")
emitFields("CommonFields", Common)

for _, class in Classes do
    emitFields(`{class.Name}Fields`, class.Fields)
end

emit("// Every replicated class, in schema order.")
emit("inline constexpr ClassDesc Classes[] = {")
for _, class in Classes do
    local fields = if hasArray[`{class.Name}Fields`] then `{class.Name}Fields` else "{}"
    emit("    {" .. `{quote(class.Name)}, {fields}` .. "},")
end
emit("};")
emit("")

-- Channels.
emit("// ENet's delivery mode per channel, as `net::Delivery` spells it.")
emit("enum class Delivery : u8")
emit("{")
emit("    Reliable = 0,")
emit("    UnreliableSequenced = 1,")
emit("    Unreliable = 2,")
emit("};")
emit("")
emit("struct ChannelDesc")
emit("{")
emit("    std::string_view name;")
emit("    u8 id = 0;")
emit("    Delivery delivery = Delivery::Reliable;")
emit("};")
emit("")
emit("inline constexpr ChannelDesc Channels[] = {")
for _, channel in Channels do
    emit("    {" .. `{quote(channel.Name)}, {channel.Id}, Delivery::{channel.Delivery}` .. "},")
end
emit("};")
emit("")

-- Messages, as an enum plus a table. The enum is what code switches on.
emit("// The message types. An enum rather than bare numbers, so a switch over them")
emit("// is exhaustive and `-Werror` catches a new one nobody handled.")
emit("enum class MessageType : u8")
emit("{")
for _, message in Messages do
    emit(`    {message.Name} = {message.Id},`)
end
emit("};")
emit("")
emit("// Which direction a message may travel. A server that accepted a")
emit("// `ToReplica` message from a client would be a server accepting whatever a")
emit("// client asserted about the world.")
emit("enum class Direction : u8")
emit("{")
emit("    ToAuthority = 0,")
emit("    ToReplica = 1,")
emit("};")
emit("")
emit("struct MessageDesc")
emit("{")
emit("    std::string_view name;")
emit("    MessageType type = MessageType::Hello;")
emit("    u8 channel = 0;")
emit("    Direction direction = Direction::ToAuthority;")
emit("};")
emit("")

local channelIdOf: { [string]: number } = {}
for _, channel in Channels do
    channelIdOf[channel.Name] = channel.Id
end

emit("inline constexpr MessageDesc Messages[] = {")
for _, message in Messages do
    local channel = channelIdOf[message.Channel]
    if channel == nil then
        fail(`message {message.Name} names channel {message.Channel}, which is not declared`)
    end
    emit(
        "    {"
            .. `{quote(message.Name)}, MessageType::{message.Name}, {channel}, Direction::{message.Direction}`
            .. "},"
    )
end
emit("};")
emit("")
emit("} // namespace luaug::replication::generated")
emit("")

local directory = "engine/replication/generated"
if not fs.exists(directory) then
    fs.createDirectory(directory, { makeParents = true })
end
fs.writeStringToFile(OutputPath, table.concat(lines, "\n"))

local fieldCount = #Common
for _, class in Classes do
    fieldCount += #class.Fields
end

print(
    `gen_wire: wrote {OutputPath} -- protocol v{Wire.ProtocolVersion}, {#Classes} class(es), `
        .. `{fieldCount} field(s), {#Channels} channel(s), {#Messages} message(s)`
)
