--!strict
--[[
	The editor's icon ids, as C++ constants generated from the theme that
	defines them.

	`icons/default/theme.json` is the list of ids that exist. Anything that
	names one by hand is a string a typo turns into a blank square at runtime,
	found by whoever happens to look at that panel — which is the failure mode
	this repository already generates C++ to avoid everywhere else
	(`api/generator/gen_cpp.luau` writes the class descriptors for the same
	reason).

	So the ids become `constexpr std::string_view`s. A typo is then a compile
	error, a removed icon breaks the build of whatever still asks for it, and
	the icon list and the code that draws them cannot drift apart quietly.

	**Class ids are emitted too but are not how the Explorer looks one up.** A
	tree row asks for `"class." + whatever class the world holds`, because a
	project may register a class this build has never heard of; that lookup
	misses and falls back, which is designed rather than broken. The constants
	are for the call sites that name a specific class on purpose.

	    lute tools/repo/genicons.luau

	Checked in and freshness-gated by `scripts/gates/luau-check.sh`, like every
	other generated file here.
]]

local fs = require("@std/fs")
local json = require("@std/json")
local process = require("@std/process")

local ThemePath = "icons/default/theme.json"
local OutputPath = "engine/app/generated/icon_ids.gen.h"

local function fail(message: string): never
    print(`genicons: ERROR: {message}`)
    return process.exit(1)
end

if not fs.exists(ThemePath) then
    fail(`{ThemePath} is missing`)
end

local theme = json.asObject(json.deserialize(fs.readFileToString(ThemePath)))
if not theme then
    fail(`{ThemePath} is not an object`)
end

local icons = json.asObject((theme :: json.Object).icons)
if not icons then
    fail(`{ThemePath} has no "icons" object`)
end

local fallback = (theme :: json.Object).fallback
if typeof(fallback) ~= "string" or (icons :: json.Object)[fallback] == nil then
    fail(`{ThemePath} declares a fallback that is not one of its own ids`)
end

--- The id, as a C++ identifier. `class.MeshPart` becomes `ClassMeshPart`:
--- the prefix is a namespace in the data and a word in the name, because a
--- nested C++ namespace per group would make every call site read
--- `icons::class_::MeshPart` and `class` is a keyword anyway.
local function identifierFor(id: string): string
    local group, name = string.match(id, "^([%a]+)%.(.+)$")
    if group == nil or name == nil then
        fail(`"{id}" is not <group>.<Name>`)
    end
    local head = string.upper(string.sub(group :: string, 1, 1)) .. string.sub(group :: string, 2)
    -- A class name is already PascalCase and a content kind is too; an action
    -- name is as well. Nothing here has to be re-cased, only joined.
    return head .. (name :: string)
end

-- `@std/json` tags decoded objects with a `newproxy()` sentinel key, so
-- iteration yields a userdata alongside the real keys.
local ids: { string } = {}
for id in icons :: json.Object do
    if typeof(id) == "string" then
        table.insert(ids, id)
    end
end
table.sort(ids)

local lines: { string } = {
    "// GENERATED by tools/repo/genicons.luau from icons/default/theme.json. Do not edit.",
    "//",
    "// The editor's icon ids. See `icons/README.md` for what a theme is and how a",
    "// lookup resolves, and `engine/app/include/luaug/app/icons.h` for the atlas",
    "// that answers one.",
    "#pragma once",
    "",
    "#include <string_view>",
    "",
    "namespace luaug::app::icons {",
    "",
    "// The id drawn when a lookup misses. Complete by construction: `default` is",
    "// the only theme that has to carry every id, and this is the one it promises",
    "// hardest.",
    `inline constexpr std::string_view Fallback = "{fallback}";`,
    "",
}

local group: string? = nil
for _, id in ids do
    local head = string.match(id, "^([%a]+)%.")
    if head ~= group then
        group = head
        if #lines > 0 and lines[#lines] ~= "" then
            table.insert(lines, "")
        end
        table.insert(lines, `// {head}.*`)
    end
    table.insert(lines, `inline constexpr std::string_view {identifierFor(id)} = "{id}";`)
end

table.insert(lines, "")
table.insert(lines, "} // namespace luaug::app::icons")
table.insert(lines, "")

local directory = string.match(OutputPath, "^(.*)/[^/]*$")
if directory ~= nil and not fs.exists(directory) then
    fs.createDirectory(directory, { makeParents = true })
end
fs.writeStringToFile(OutputPath, table.concat(lines, "\n"))

print(`genicons: wrote {OutputPath} -- {#ids} id(s)`)
