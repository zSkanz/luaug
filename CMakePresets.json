{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{LUAUG_BUILD_ROOT}/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win-msvc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "macos-clang",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },

    { "name": "win-msvc-debug",    "inherits": "win-msvc",    "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug",          "LUAUG_PROFILE": "debug" } },
    { "name": "win-msvc-dev",      "inherits": "win-msvc",    "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "LUAUG_PROFILE": "dev" } },
    { "name": "win-msvc-shipping", "inherits": "win-msvc",    "cacheVariables": { "CMAKE_BUILD_TYPE": "Release",        "LUAUG_PROFILE": "shipping" } },
    { "name": "linux-clang-debug", "inherits": "linux-clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug",          "LUAUG_PROFILE": "debug" } },
    { "name": "linux-clang-dev",   "inherits": "linux-clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "LUAUG_PROFILE": "dev" } },
    { "name": "linux-clang-asan",  "inherits": "linux-clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "LUAUG_PROFILE": "dev", "LUAUG_SANITIZE": "address,undefined" } },
    { "name": "macos-clang-dev",   "inherits": "macos-clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "LUAUG_PROFILE": "dev" } }
  ],
  "buildPresets": [
    { "name": "win-msvc-debug",    "configurePreset": "win-msvc-debug" },
    { "name": "win-msvc-dev",      "configurePreset": "win-msvc-dev" },
    { "name": "win-msvc-shipping", "configurePreset": "win-msvc-shipping" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-dev",   "configurePreset": "linux-clang-dev" },
    { "name": "linux-clang-asan",  "configurePreset": "linux-clang-asan" },
    { "name": "macos-clang-dev",   "configurePreset": "macos-clang-dev" }
  ],
  "testPresets": [
    { "name": "win-msvc-debug",    "configurePreset": "win-msvc-debug",    "output": { "outputOnFailure": true } },
    { "name": "win-msvc-dev",      "configurePreset": "win-msvc-dev",      "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-dev",   "configurePreset": "linux-clang-dev",   "output": { "outputOnFailure": true } },
    { "name": "linux-clang-asan",  "configurePreset": "linux-clang-asan",  "output": { "outputOnFailure": true } },
    { "name": "macos-clang-dev",   "configurePreset": "macos-clang-dev",   "output": { "outputOnFailure": true } }
  ]
}
